{
    "includeCoAuthoredBy": false,
    "permissions": {
      "allow": ["Bash(git push:*)"]
    },
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/bin/slopsentry hook || true",
              "timeout": 30
            }
          ]
        }
      ]
    }
  }
